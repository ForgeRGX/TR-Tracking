# Copy this file to .env and change the passwords: cp .env.example .env
# Tip: use passwords without spaces, quotes, or the $ symbol

MYSQL_DATABASE=investments
MYSQL_USER=investments_user
MYSQL_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_this_password_root

# Web port (http://localhost:8080)
WEB_PORT=8080
# Local port to connect an SQL client to MySQL (127.0.0.1 only)
DB_HOST_PORT=3307

# production = generic errors; set APP_DEBUG=true to show details
# true = anyone can create an account at /register. Set to false once you have your users
# (If no users exist, registration is always available to create the first one)
ALLOW_REGISTRATION=true

APP_ENV=production
APP_DEBUG=false
APP_VERSION=v1.0.0
APP_COMMIT=46b0e551
TZ=Europe/Madrid

GITHUB_REPOSITORY=ForgeRGX/TR-Tracking